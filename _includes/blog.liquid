---
layout: default
---
<div class="blog">
	{% for post in collections.posts %}
	<div class="bloglink">
		<h3 class="bloglinktitle"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
		<p class="blogpreview">{{ post.data.excerpt }}</p>
		<time>{{ post.date | date: "%d %b %Y" }}</time>
	</div>
	{% endfor %}
</div>
<p></p>
<footer><a href="feed.xml">[atom]</a></footer>
